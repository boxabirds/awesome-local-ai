{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-22",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    // Room connections (and e2e-only test hooks) always reach the Worker, never the SPA fallback.
    "run_worker_first": ["/api/*", "/__test/*"],
    "not_found_handling": "single-page-application"
  },
  // Uploaded images (story 12).
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }],
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  // SQLite-backed: each board's saved state lives in its room's SQLite database (story 4).
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
