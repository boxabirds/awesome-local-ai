{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"],
    "noEmit": true
  },
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  // Worker code and its workerd tests use the Workers runtime types: see tsconfig.worker.json.
  "exclude": [
    "src/worker",
    "tests/integration",
    "tests/unit/board-store-chunks.test.ts",
    "tests/unit/room-state.test.ts",
    "tests/unit/create-board.test.ts"
  ]
}
