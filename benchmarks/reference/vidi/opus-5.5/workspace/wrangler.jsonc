{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Room connections always reach the Worker, never the SPA fallback. /__test/* reaches the
    // Worker too; without TEST_HOOKS it hands the request back to the assets (SPA/404).
    "run_worker_first": ["/api/*", "/__test/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  // Board creation limit per visitor (CF-Connecting-IP). limit/period mirror BOARD_CREATE_LIMIT and
  // BOARD_CREATE_PERIOD_SECONDS in src/shared/config.ts (unit test TC-03 asserts they match).
  "ratelimits": [
    { "name": "BOARD_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Image uploads per visitor (story 12); mirrors IMAGE_UPLOAD_LIMIT / IMAGE_UPLOAD_PERIOD_SECONDS.
    { "name": "ASSET_UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Uploaded images (story 12): keys '<boardId>/<assetId>', served by GET /api/assets/*.
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }],
  // SQLite-backed from the start so story 4 (persistence) needs no class migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
