{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees only /api/* (and /__test/*, which is the static client unless TEST_HOOKS=1 enables the
    // e2e storage hooks); every other path is served straight from the assets.
    "run_worker_first": ["/api/*", "/__test/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  // Board creation limit per visitor (CF-Connecting-IP). Mirrors BOARD_CREATE_LIMIT / BOARD_CREATE_PERIOD_SECONDS
  // in src/shared/config.ts; tests/unit/create-board.test.ts fails if they drift apart.
  // Image uploads per visitor mirror IMAGE_UPLOAD_LIMIT / IMAGE_UPLOAD_PERIOD_SECONDS (tests/unit/image-format.test.ts).
  "ratelimits": [
    { "name": "BOARD_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "ASSET_UPLOAD_LIMITER", "namespace_id": "1002", "simple": { "limit": 60, "period": 60 } }
  ],
  // Uploaded images (story 12), keyed <boardId>/<assetId>.
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }],
  // SQLite-backed from the start so story 4 (persistence) needs no class migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
