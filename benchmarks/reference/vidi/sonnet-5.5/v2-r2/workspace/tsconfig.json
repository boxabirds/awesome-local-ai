{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["vite/client"]
  },
  "include": ["src/client", "src/shared", "tests/unit", "tests/component", "tests/e2e", "tests/fixtures","vite.config.ts", "vitest.config.ts", "playwright.config.ts"]
}
