# Reference stack: Claude Code (headless) + Claude Sonnet 5.5, run by the Vidi harness like any local setup.
# Installed per machine with: benchmarks/reference/install-stack.sh benchmarks/reference/vidi/sonnet-5.5
INSTALL_ID="claude-code-sonnet-5-5"
DISPLAY_NAME="Claude Code + Claude Sonnet 5.5"
BACKEND="anthropic"            # cloud: run.sh starts no local server
CLIENT="claude"                # harness client (benchmarks/spec-bench/harness/clients.py: ClaudeClient)
MODEL_ID="claude-sonnet-5-5"
# The provider manages context and output limits; 0 marks them as not set by the harness.
CONTEXT_LIMIT=0
OUTPUT_LIMIT=0
