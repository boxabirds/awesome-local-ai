{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "baseUrl": ".",
    "types": [
      "@cloudflare/workers-types"
    ]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "tests/unit/**/*.ts", "tests/component/Sticky*.test.tsx", "tests/component/Toolbars.test.tsx", "tests/component/BoardViewport.test.tsx", "tests/component/NavigationHint.test.tsx", "tests/component/ZoomControls.test.tsx", "tests/component/UndoControls.test.tsx", "tests/component/UndoBoundaries.test.tsx", "tests/component/TextToolbar.test.tsx", "tests/component/TextEditor.test.tsx", "tests/e2e/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
