{
  "name": "vidi6",
  "compatibility_date": "2025-01-15",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "main": "src/worker/index.ts",
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_ROOM", "class_name": "BoardRoom" }
    ]
  },
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }
  ],
  "observability": {
    "enabled": false
  }
}
