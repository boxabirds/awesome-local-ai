{
  "name": "vidi6",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "WRANGLER_SEND_METRICS=false vite build && WRANGLER_SEND_METRICS=false vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:nightly": "playwright test --config playwright.nightly.config.ts"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@playwright/test": "^1.64.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0",
    "ws": "^8.22.0"
  }
}
