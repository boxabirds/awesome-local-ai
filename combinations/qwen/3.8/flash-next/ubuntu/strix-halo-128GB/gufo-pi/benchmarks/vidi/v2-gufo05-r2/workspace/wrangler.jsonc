{
  // Cloudflare Worker configuration. Story 1 serves the client as static
  // assets only; Worker code (Durable Objects for realtime) arrives in story 3.
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  // Assets-only for now: an `assets.binding` requires a Worker script, which
  // story 3 adds together with the realtime Durable Object.
  "assets": {
    "directory": "./dist/client"
  }
}
