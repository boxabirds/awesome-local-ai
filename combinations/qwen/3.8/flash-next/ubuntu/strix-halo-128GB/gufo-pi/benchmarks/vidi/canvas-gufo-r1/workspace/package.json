    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:nightly": "playwright test --config=playwright.nightly.config.ts"
  },
  "dependencies": {
    "lib0": "^0.2.118",
    "react": "^19.2.0",
