{
  "name": "vidi6",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "npm run typecheck:client && npm run typecheck:worker",
    "typecheck:client": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "npm run build && vitest run --project integration --project live",
    "e2e:serve": "npm run build:test && wrangler dev --ip 127.0.0.1 --port ${VIDI6_E2E_PORT:-28736} --inspector-port 28737",
    "test:e2e": "playwright test",
    "test:e2e:nightly": "VIDI6_NIGHTLY=1 playwright test --grep @nightly"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
