{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  // The newest date both the local `wrangler` and the workerd bundled by
  // `@cloudflare/vitest-pool-workers` accept (see NOTES.md).
  "compatibility_date": "2026-08-22",
  // The Worker owns routing: /api/rooms/<boardId> to a BoardRoom, everything
  // else to the built client (see src/worker/index.ts).
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    // The client is a single-page app: /b/<boardId> has no file behind it.
    "not_found_handling": "single-page-application",
    // Every request goes through the Worker first, so the room routes are the
    // Worker's own decision rather than a gap in the asset listing.
    "run_worker_first": true
  },
  // Board pictures (story 12). The Worker is the only thing that can read or write this
  // bucket: nothing public is mounted on it, so a picture is reachable by its
  // unguessable `<boardId>/<assetId>` key and by nothing else.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // SQLite-backed from the start: story 4 persists the document and must not
  // need a class migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  // `TEST_HOOKS` is deliberately absent: it is what routes the `/__test/boards/...`
  // endpoints that damage a board's snapshot on purpose, and the E2E harness passes it
  // on the command line (`--var TEST_HOOKS:1`) to the dev server it starts. Uncomment
  // only for a local run you want to break by hand.
  // "vars": {
  //   "TEST_HOOKS": "1"
  // }
}
