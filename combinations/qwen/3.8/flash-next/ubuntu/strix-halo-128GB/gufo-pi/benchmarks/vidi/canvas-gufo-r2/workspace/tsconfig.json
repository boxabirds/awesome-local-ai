{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/client/**/*", "src/shared/**/*", "tests/unit/**/*", "tests/component/**/*", "tests/e2e/**/*", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["src/worker", "tests/integration", "vitest.integration.config.ts"]
}
