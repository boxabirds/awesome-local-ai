{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "types": ["vite/client", "node"]
  },
  // The Worker and its integration tests run in workerd, not in a browser: they
  // belong to `tsconfig.worker.json`, because the generated runtime types and
  // the DOM lib describe the same globals differently.
  "include": ["src", "tests", "vite.config.ts", "vitest.config.ts", "playwright.config.ts"],
  "exclude": ["src/worker", "tests/integration", "tests/unit/board-store-chunks.test.ts"]
}
