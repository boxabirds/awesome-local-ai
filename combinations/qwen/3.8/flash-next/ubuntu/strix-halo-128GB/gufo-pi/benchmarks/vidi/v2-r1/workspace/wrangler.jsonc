{
  // Cloudflare Worker configuration.
  // Story 1 ships the static client only, so this is an assets-only Worker
  // (no `binding`: wrangler rejects an asset binding without a Worker script).
  // Story 3 adds `main` plus the `ASSETS` binding and Durable Objects.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  }
}
