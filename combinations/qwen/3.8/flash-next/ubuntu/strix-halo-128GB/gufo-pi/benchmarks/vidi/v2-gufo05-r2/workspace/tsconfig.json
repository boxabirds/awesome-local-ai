{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src/client",
    "src/shared",
    "tests/unit",
    "tests/component",
    "tests/e2e",
    "tests/fixtures",
    // The integration tests that run on Node (a real server + real WebSockets).
    // The one that runs inside workerd is in tsconfig.worker.json.
    "tests/integration/board-room.test.ts",
    "tests/integration/global-setup.ts",
    "tests/integration/helpers",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
