{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "main": "src/worker/index.ts",
  // The newest date both the deployed runtime and the workerd build that
  // @cloudflare/vitest-pool-workers ships understand; nothing here depends on a
  // newer one.
  "compatibility_date": "2026-08-22",
  // One BoardRoom Durable Object per board. SQLite-backed from the start so that
  // story 4 (keeping boards) needs no class migration.
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  // The Worker owns routing (`/api/rooms/:boardId`), so assets come through a
  // binding. Unknown paths fall back to index.html: `/b/<boardId>` is a client
  // route, not a file.
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ]
}
