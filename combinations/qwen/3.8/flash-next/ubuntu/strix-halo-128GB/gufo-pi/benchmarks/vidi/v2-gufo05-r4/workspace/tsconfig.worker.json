{
  "compilerOptions": {
    "target": "ES2022",
    // workerd, not a browser: `worker-configuration.d.ts` (from `wrangler types`)
    // provides the runtime globals, so this project deliberately has no DOM lib.
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Only the workerd runtime types plus `cloudflare:test` for the integration
    // project; no DOM, no node.
    "types": ["@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "worker-configuration.d.ts",
    "src/worker",
    "src/shared",
    "tests/integration"
  ]
}
