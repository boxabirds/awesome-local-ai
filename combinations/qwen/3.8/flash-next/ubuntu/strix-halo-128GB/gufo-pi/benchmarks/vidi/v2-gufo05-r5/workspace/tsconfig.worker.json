{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The Workers runtime: no DOM lib, and the runtime + generated binding types instead.
    // `src/worker` and `tests/integration` therefore get their own project; the client
    // project (`tsconfig.json`) keeps the DOM lib and excludes both.
    "lib": ["ES2022"],
    "types": ["@cloudflare/vitest-pool-workers/types"]
  },
  "include": ["worker-configuration.d.ts", "src/worker", "src/shared", "tests/integration"],
  "exclude": []
}
