{
  "name": "vidi6",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:hooks": "vitest run --config vitest.hooks.config.ts",
    "test:component": "vitest run --project component",
    "test:e2e": "playwright test --project=chromium --grep-invert @nightly",
    "test:e2e:all": "playwright test",
    "wrangler:dev": "wrangler dev"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.9.14",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.54.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.6.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.20.0"
  }
