// vidi6: a Cloudflare Worker that serves the built client and one BoardRoom Durable
// Object per board (story 3, live collaboration).
//
// `run_worker_first` keeps all routing in `src/worker/index.ts`: the room API goes to a
// BoardRoom, everything else to the assets, whose `single-page-application` handling turns
// client-side routes like `/b/<boardId>` into `index.html`.
//
// The migration is SQLite-backed (`new_sqlite_classes`) already so story 4 can persist
// boards without a class migration; this story never writes to storage.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  // 2026-08-01 rather than today: the workerd binary bundled by
  // @cloudflare/vitest-pool-workers (through its pinned wrangler) supports dates up to
  // 2026-08-22, and the integration project runs the same wrangler.jsonc.
  "compatibility_date": "2026-08-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  // Story 12: the bytes of the images people add. Keys are `<boardId>/<assetId>` - two unguessable
  // addresses - so a stored image is no easier to find than the board it belongs to.
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }],
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
