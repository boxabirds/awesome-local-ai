{
  // Cloudflare Worker configuration. The Worker serves the built client and
  // routes /api/rooms/:boardId to a BoardRoom Durable Object per board.
  // The migration is SQLite-backed from the start so story 4 (persistence)
  // needs no class migration.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-08-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BoardRoom"
      ]
    }
  ]
}
