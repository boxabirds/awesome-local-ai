{
  // Cloudflare Worker config. Story 3 adds the Worker (`main`) and the
  // BoardRoom Durable Object; the built client stays behind the assets binding.
  // The migration is SQLite-backed from the start so story 4 needs no class
  // migration.
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  // Story 12: uploaded images live in R2 under `<boardId>/<assetId>`; the keys
  // are unguessable, so the bucket is read by key alone.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "vidi6-board-create",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      // PRD image.rate_limit: IMAGE_UPLOAD_LIMIT uploads per IP per period.
      "name": "ASSET_UPLOAD_LIMITER",
      "namespace_id": "vidi6-asset-upload",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
