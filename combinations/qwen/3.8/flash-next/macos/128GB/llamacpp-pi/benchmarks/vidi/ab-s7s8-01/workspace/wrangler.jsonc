{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "board-create-limiter",
      // limit/period mirror BOARD_CREATE_LIMIT / BOARD_CREATE_PERIOD_SECONDS in
      // src/shared/config.ts. tests/unit/create-board.test.ts (TC-03) fails if
      // these drift from the named settings.
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ]
}
