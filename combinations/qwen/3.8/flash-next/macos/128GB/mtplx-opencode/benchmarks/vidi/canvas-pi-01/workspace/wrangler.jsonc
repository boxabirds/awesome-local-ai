{
  // Cloudflare Worker application. Story 3 adds the Worker `main` entry and
  // the BoardRoom Durable Object on top of the static-asset serving from
  // story 1. The same file is read by `wrangler dev` (e2e) and by the
  // `@cloudflare/vitest-pool-workers` integration project, so tests exercise
  // the real deploy shape (design "Mock vs real boundaries").
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "ASSET_UPLOAD_LIMITER",
      "namespace_id": "1011",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ],
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  // Kept at or below the workerd runtime bundled with
  // `@cloudflare/vitest-pool-workers` so `wrangler dev` and the integration
  // tests share one compatible date.
  "compatibility_date": "2026-08-15",
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "env": {
    // `wrangler dev --env e2e` (what playwright.config.ts starts): the only
    // environment where the /__test/* storage-surgery routes exist. Wrangler
    // does not inherit `durable_objects` into an environment, so the room
    // binding and its migration are repeated here.
    "e2e": {
      "vars": {
        "TEST_HOOKS": "1"
      },
      // The shared e2e server is one visitor to every browser project at
      // once, so the create limiter is raised here; TC-30 exercises the real
      // 10-per-minute limit against its own server (`e2e_limited` below).
      "ratelimits": [
        {
          "name": "BOARD_CREATE_LIMITER",
          "namespace_id": "1002",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        },
        {
          "name": "ASSET_UPLOAD_LIMITER",
          "namespace_id": "1012",
          "simple": {
            "limit": 2000,
            "period": 60
          }
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "vidi6-assets"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "BOARD_ROOM",
            "class_name": "BoardRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BoardRoom"]
        }
      ]
    },
    // TC-30's dedicated environment: the production create limit (10 a
    // minute), so the 11th board in one test is a real 429 rather than a
    // stubbed one. Started with `wrangler dev --env e2e_limited`.
    "e2e_limited": {
      "vars": {
        "TEST_HOOKS": "1"
      },
      "ratelimits": [
        {
          "name": "BOARD_CREATE_LIMITER",
          "namespace_id": "1003",
          "simple": {
            "limit": 10,
            "period": 60
          }
        },
        {
          "name": "ASSET_UPLOAD_LIMITER",
          "namespace_id": "1013",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "r2_buckets": [
        {
          "binding": "ASSETS_BUCKET",
          "bucket_name": "vidi6-assets"
        }
      ],
      "durable_objects": {
        "bindings": [
          {
            "name": "BOARD_ROOM",
            "class_name": "BoardRoom"
          }
        ]
      },
      "migrations": [
        {
          "tag": "v1",
          "new_sqlite_classes": ["BoardRoom"]
        }
      ]
    }
  }
}