{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "lib": [
      "ES2022"
    ],
    "types": [
      "@cloudflare/workers-types/experimental"
    ],
    "noUnusedLocals": false,
    "noUnusedParameters": false
  },
  "include": [
    "src/worker",
    "src/shared",
    "tests/integration",
    "vitest.config.ts"
  ],
  "exclude": [
    "src/client"
  ]
}
