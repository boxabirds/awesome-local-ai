{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers"]
  },
  "include": ["src/worker", "src/shared", "tests/integration", "tests/fixtures"],
  // The worker program has no DOM library on purpose. A fixture that renders React
  // is client code and belongs to the client program (tsconfig.json), which is
  // where it gets checked; leaving it here would drag every src/client component
  // into a program that has never heard of `document`.
  "exclude": ["tests/fixtures/testbox.tsx"]
}
