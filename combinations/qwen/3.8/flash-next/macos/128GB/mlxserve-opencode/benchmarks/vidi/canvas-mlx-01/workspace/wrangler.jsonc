{
  // vidi6 deployment configuration (design requirement).
  //
  // The client build in `dist/client` is the whole story-1 experience; the entry
  // Worker exists so the `ASSETS` binding is valid and so `BACKEND` is available
  // to Worker code (the collaborative backend itself arrives in story 3).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "main": "src/worker/index.ts",

  // The Worker context has an `env.BACKEND` value bound to this bucket.
  "kv_namespaces": [
    {
      "binding": "BACKEND",
      "id": "1c0aa1c0aa1c0aa1c0aa1c0aa1c0aa1c",
      "bucket_name": "vidi6-backend",
      "preview_bucket_name": "vidi6-backend"
    }
  ],

  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },

  "dev": {
    "ip": "127.0.0.1",
    "port": 8790,
    "local_protocol": "http"
  }
}
