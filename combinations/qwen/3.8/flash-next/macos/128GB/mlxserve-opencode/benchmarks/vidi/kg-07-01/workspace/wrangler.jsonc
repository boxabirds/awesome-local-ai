{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The Worker sees only /api/* (and /__test/*, which is the static client unless TEST_HOOKS=1 enables the
    // e2e storage hooks); every other path is served straight from the assets.
    "run_worker_first": ["/api/*", "/__test/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  // Board creation limit per visitor (CF-Connecting-IP). Mirrors BOARD_CREATE_LIMIT / BOARD_CREATE_PERIOD_SECONDS
  // in src/shared/config.ts; tests/unit/create-board.test.ts fails if they drift apart.
  "ratelimits": [{ "name": "BOARD_CREATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } }],
  // SQLite-backed from the start so story 4 (persistence) needs no class migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
