{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  // The Worker is the entry point: it routes /api/rooms/:boardId to a BoardRoom and hands
  // everything else to the assets. `run_worker_first` is what makes that order possible -
  // without it the asset router answers the SPA fallback for /api/* and the Worker never
  // sees the WebSocket upgrade.
  "main": "src/worker/index.ts",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      // Story 4's e2e suite damages a board's storage through /__test/..., which only exists when
      // the server was started with TEST_HOOKS=1. Everywhere else the Worker has no route for it
      // and the answer is the app, so it has to reach the Worker to be found missing there too.
      "/__test/*"
    ]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // Story 12: where the pictures are kept. One bucket for every board, and every key beginning with the
  // id of the board it belongs to - which is what lets a bucket that answers for any key it is given still
  // be a bucket nobody can enumerate. Local development and the integration tests get a bucket of their
  // own in Miniflare's own directory; nothing here refers to a real Cloudflare bucket by name.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  // SQLite from the first migration, so story 4 (which stores the document) needs no class
  // migration. In this story the room's document lives only in memory.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "BoardRoom"
      ]
    }
  ],
  "dev": {
    "ip": "127.0.0.1",
    "port": 23612,
    "inspector_port": 23613
  }
}
