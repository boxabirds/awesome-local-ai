{
  // Static-assets-only Worker for now: `wrangler dev` serves the built client
  // from dist/client. The Worker `main` entry point arrives in story 3.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  }
}
