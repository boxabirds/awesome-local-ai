{
  "name": "vidi6",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test": "vite build --mode test",
    "typecheck": "npm run typecheck:client && npm run typecheck:worker",
    "typecheck:client": "tsc --noEmit",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "preview": "vite preview",
    "test": "npm run test:unit && npm run test:component && npm run test:integration",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vite build && vitest run --project integration",
    "test:e2e": "npm run build:test && playwright test",
    "test:e2e:nightly": "npm run build:test && playwright test --project nightly",
    "e2e:serve": "npm run build:test && CI=1 WRANGLER_SEND_METRICS=false wrangler dev --local --ip 127.0.0.1 --port ${VIDI6_E2E_PORT:-20784} --inspector-port ${VIDI6_E2E_INSPECTOR_PORT:-20785}"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261005.1",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
