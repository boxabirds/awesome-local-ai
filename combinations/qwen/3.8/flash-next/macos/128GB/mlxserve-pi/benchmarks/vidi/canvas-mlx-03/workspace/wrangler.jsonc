{
  "name": "vidi6",
  // Story 5 needs Durable Object RPC (stub.initialize() / stub.exists()); this
  // date is at or after the date the runtime enables RPC. The locally installed
  // workerd clamps to its newest supported date, which still has RPC.
  "compatibility_date": "2025-07-18",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // Story 12: the bytes of every image, outside the document. A board's images are one
  // prefix of this bucket (key '<boardId>/<assetId>'), which is what makes a board's
  // pictures one deletable group and its link the only thing needed to read them.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  // Board creation rate limit (share.rate_limit). `limit` and `period` MUST
  // mirror BOARD_CREATE_LIMIT and BOARD_CREATE_PERIOD_SECONDS in
  // src/shared/config.ts; unit test TC-03 parses this file and asserts equality.
  // Declared as an `unsafe` binding because the pinned wrangler (v3) only
  // exposes the Rate Limiting API that way; wrangler v4 promotes it to a
  // top-level `ratelimits` array with the same fields.
  "unsafe": {
    "bindings": [
      {
        "type": "ratelimit",
        "name": "BOARD_CREATE_LIMITER",
        "namespace_id": "1001",
        "param_count": 1,
        "simple": { "limit": 10, "period": 60 }
      },
      // Image upload rate limit (image.rate_limit). `limit` and `period` MUST mirror
      // IMAGE_UPLOAD_LIMIT and IMAGE_UPLOAD_PERIOD_SECONDS in src/shared/config.ts;
      // tests/unit/image-settings.test.ts asserts the parity, as it does for the
      // creation limit above. A separate namespace: running out of picture allowance
      // must not stop somebody from opening a board.
      {
        "type": "ratelimit",
        "name": "ASSET_UPLOAD_LIMITER",
        "namespace_id": "1002",
        "param_count": 1,
        "simple": { "limit": 60, "period": 60 }
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ]
}
