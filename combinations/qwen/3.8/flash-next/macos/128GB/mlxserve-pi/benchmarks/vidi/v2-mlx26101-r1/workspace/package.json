{
  "name": "vidi6",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vite build && vitest run --project integration",
    "build:test": "vite build --mode test",
    "test:e2e": "npm run build:test && touch src/worker/index.ts && playwright test --grep-invert @nightly",
    "test:e2e:nightly": "npm run build:test && touch src/worker/index.ts && playwright test --grep @nightly",
    "deploy": "wrangler deploy",
    "start": "wrangler dev",
    "test:e2e:persist": "npm run build:test && playwright test -c playwright.persistence.config.ts --grep-invert @nightly",
    "test:e2e:persist:nightly": "npm run build:test && playwright test -c playwright.persistence.config.ts --grep @nightly"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@playwright/test": "^1.56.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.0",
    "wrangler": "^4.0.0"
  }
}
