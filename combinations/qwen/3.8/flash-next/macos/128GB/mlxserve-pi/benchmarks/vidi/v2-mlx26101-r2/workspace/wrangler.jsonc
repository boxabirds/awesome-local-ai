{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  // Kept at or below the compatibility date that the workerd binary bundled with
  // @cloudflare/vitest-pool-workers understands, so `npm run test:integration`
  // (which reads this same file) can start the runtime.
  "compatibility_date": "2026-08-22",
  "compatibility_flags": ["nodejs_als"],
  // Story 3 adds the Worker: it routes /api/rooms/:boardId to that board's
  // BoardRoom Durable Object and serves everything else from the client assets.
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // Story 12: the images people drop on a board. Keyed `{boardId}/{assetId}`, and the
  // only reader is the Worker - there is no public bucket domain, so every byte that
  // leaves here leaves through `GET /api/assets/...`, which is what lets the Worker's
  // own checks (signature, size, key shape) be the product's checks rather than a
  // suggestion. Local development and the tests get a bucket of their own from this
  // entry; `wrangler r2 bucket create vidi6-assets` is what a real deployment needs.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  // SQLite-backed from the start, so story 4 (boards that outlive the last
  // person) adds storage without a class migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ]
}
