{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // Story 12: the pictures. One bucket for every board; the object key carries the board id
  // (`<boardId>/<assetId>`), so a bucket can be audited without a lookup table, and a read that
  // cannot name a valid key gets nothing. Local `wrangler dev` simulates it on disk.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets",
      "preview_bucket_name": "vidi6-assets-preview"
    }
  ],
  // SQLite-backed classes from day one, so story 4 (which persists the board in
  // this same object) needs no class migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ]
}
