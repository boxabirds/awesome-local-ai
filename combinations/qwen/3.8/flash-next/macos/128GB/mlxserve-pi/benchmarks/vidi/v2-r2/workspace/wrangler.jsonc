{
  // vidi6: a static client plus one BoardRoom Durable Object per board address.
  // The Worker (`main`) routes `/api/rooms/:boardId` to that board's room and
  // serves everything else from the built client assets.
  "name": "vidi6",
  // Shared by the e2e `wrangler dev` and the vitest workerd pool; kept at a date
  // every workerd binary in this repo supports.
  "compatibility_date": "2026-08-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // The board pictures (story 12). One object per image, keyed `<boardId>/<assetId>`.
  // Development and the tests get Miniflare's own bucket at the same binding name; a real
  // deployment points it at a bucket that exists, and the asset route's 404 is what a board
  // whose bucket was never made looks like.
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "vidi6-assets"
    }
  ],
  // SQLite-backed from the start so story 4's persistence needs no class migration.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ]
}
