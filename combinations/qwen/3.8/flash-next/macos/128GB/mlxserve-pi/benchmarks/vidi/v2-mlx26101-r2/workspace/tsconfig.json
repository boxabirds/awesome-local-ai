{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "noEmit": true
  },
  "//": "The browser side and the tests that run in node/jsdom/Playwright. The Worker and the tests that run inside workerd are in tsconfig.worker.json, because the two environments declare different globals.",
  "include": [
    "src/client",
    "src/shared",
    "tests/unit",
    "tests/component",
    "tests/e2e",
    // The boards the tests open, built with the client's own model calls. Checked by
    // both programs, because it has to work in node, in jsdom, in workerd and in
    // Playwright's node process.
    "tests/fixtures",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "exclude": [
    // Two of the unit tests test the storage layer and the room's state machine,
    // which are Worker modules (`tests/unit` otherwise tests only the modules in
    // src/shared). They run in node exactly like the other unit tests, but they
    // are type-checked by tsconfig.worker.json, because this program has no
    // Workers globals and must not grow any.
    "tests/unit/room-state.test.ts",
    "tests/unit/board-store-chunks.test.ts",
    // Story 8's undo tests are the same case for the same reason: TC-03 has to
    // apply a board update with the *real* `LOAD_ORIGIN`, which only exists in the
    // Worker's storage module, so `tests/unit/peer.ts` (the peer the undo tests
    // share) imports a Worker module. Type-checked by tsconfig.worker.json.
    "tests/unit/peer.ts",
    "tests/unit/undo-history.test.ts"
  ]
}
