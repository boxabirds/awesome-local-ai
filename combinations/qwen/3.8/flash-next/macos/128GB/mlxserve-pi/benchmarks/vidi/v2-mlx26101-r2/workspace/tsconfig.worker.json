{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["@cloudflare/workers-types/experimental", "@cloudflare/vitest-pool-workers/types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": false,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "noEmit": true
  },
  "//": "Everything that runs inside the Workers runtime: the Worker and its integration tests (`npm run test:integration`). No DOM here, on purpose: if this project compiles, the Worker does not reach for a browser API it will not have.",
  "include": [
    "src/worker",
    "src/shared",
    "tests/integration",
    "tests/fixtures",
    // The two unit tests that test Worker modules; see the note in tsconfig.json.
    "tests/unit/room-state.test.ts",
    "tests/unit/board-store-chunks.test.ts",
    // Story 8's undo tests and the peer they share, for the same reason.
    "tests/unit/peer.ts",
    "tests/unit/undo-history.test.ts"
  ],
  "exclude": [
    // The story-7 `testbox` fixture draws a React component and imports the client
    // object registry (`.tsx`), so it belongs to the client program only. The rest
    // of `tests/fixtures` is Workers-safe (pure board-model builders) and stays in.
    "tests/fixtures/testbox.tsx"
  ]
}
