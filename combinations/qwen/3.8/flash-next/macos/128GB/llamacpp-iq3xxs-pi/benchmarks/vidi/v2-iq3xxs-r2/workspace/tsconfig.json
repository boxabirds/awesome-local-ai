{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["vite/client", "node"]
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  // The Worker half of the project (and the integration tests that run inside workerd)
  // typecheck against `tsconfig.worker.json`, which has the Workers runtime types in
  // place of the DOM ones.
  // The two story 4 unit tests import the Worker half of the project, so they are
  // typechecked by `tsconfig.worker.json` instead of this one.
  "exclude": [
    "src/worker",
    "tests/integration",
    "tests/unit/board-store-chunks.test.ts",
    "tests/unit/room-state.test.ts"
  ]
}
