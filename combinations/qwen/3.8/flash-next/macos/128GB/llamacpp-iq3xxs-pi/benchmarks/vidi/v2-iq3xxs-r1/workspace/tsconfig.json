{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // "/experimental" is the DOM-compatible variant of the Workers types, so the
    // client (DOM) and the Worker (cloudflare:workers) typecheck in one program.
    "types": ["node", "vite/client", "@cloudflare/workers-types/experimental"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "noEmit": true
  },
  "include": [
    "src",
    "tests/unit",
    "tests/integration",
    "tests/fixtures",
    "tests/component",
    "tests/e2e",
    "tests/e2e-nightly",
    "vite.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ]
}
