{
  "name": "vidi6",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode development --port 27424 --strictPort --host 127.0.0.1",
    "build": "vite build --mode production",
    "build:test": "vite build --mode test",
    "preview": "vite preview --port 27424 --strictPort --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:e2e": "npm run e2e:build && playwright test",
    "e2e:build": "vite build --mode test",
    "e2e:server": "wrangler dev --ip 127.0.0.1 --port ${AGENT_PORT_E2E:-27426} --inspector-port ${AGENT_PORT_E2E_WRANGLER:-27427} --log-level=warn"
  },
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wrangler": "^4.149.0"
  }
}
