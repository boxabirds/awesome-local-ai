{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2026-08-22", // the newest date the workerd bundled with the integration test runner supports (see NOTES.md)
  // Story 3 adds the Worker `main` (routing plus the room), the `ASSETS` binding the
  // Worker falls back to, and one BoardRoom Durable Object per board. The class is
  // SQLite-backed from the start so story 4 needs no class migration.
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // Story 12 puts image bytes here instead of in a board's SQLite: the document keeps the
  // key of each object, so a board with a thousand images still loads at the speed of its
  // document. Local development gets a bucket in `.wrangler/state`; production provisions it.
  "r2_buckets": [{ "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }],
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
