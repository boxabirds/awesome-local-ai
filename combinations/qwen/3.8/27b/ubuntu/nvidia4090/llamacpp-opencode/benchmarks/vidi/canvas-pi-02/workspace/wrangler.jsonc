{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2025-06-01",
  // Story 5: rate limiter for board creation (share.rate_limit).
  // limit and period mirror BOARD_CREATE_LIMIT and BOARD_CREATE_PERIOD_SECONDS
  // in src/shared/config.ts (TC-03 asserts they do not drift).
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      // wrangler 4.139+ requires a string namespace_id on every rate limit
      // binding; locally miniflare only honours `simple`, so the id is a
      // stable identifier (a real Cloudflare namespace id in production).
      "namespace_id": "vidi6-board-create",
      "simple": {
        "limit": 10,
        "period": 60
      }
    }
  ],
  // Story 3: one BoardRoom Durable Object per board relays Yjs sync and
  // awareness over WebSockets. SQLite-backed from day one (no class
  // migration needed when story 4 starts persisting the doc).
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  // Everything that is not the /api/rooms/:boardId WebSocket route is served
  // from the client build; unknown paths fall back to index.html so the SPA
  // can resolve /b/:boardId on the client.
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  // The persist e2e suite (playwright.persist.config.ts) runs wrangler with
  // `--env e2e` so the TEST_HOOKS-gated /__test routes (story 4 TC-24) exist.
  // Production and every other env leave TEST_HOOKS unset: the paths then
  // fall through to the SPA (no Durable Object call at all).
  "env": {
    "e2e": {
      "vars": {
        "TEST_HOOKS": "1"
      },
      // This wrangler version does not inherit the top-level Durable Object
      // binding or the ratelimits binding into env-specific configs (both
      // silently disappear under `--env e2e`), so they are redeclared here,
      // including the SQLite migration that makes the storage available.
      // TC-30 (share.e2e) needs the real limiter, so it must mirror the
      // top-level limit/period (TC-03 guards the top level against
      // BOARD_CREATE_LIMIT/BOARD_CREATE_PERIOD_SECONDS).
      "ratelimits": [
        {
          "name": "BOARD_CREATE_LIMITER",
          "namespace_id": "vidi6-board-create",
          "simple": { "limit": 10, "period": 60 }
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
    }
  }
}
