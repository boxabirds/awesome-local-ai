mpt id '{case_id}' on line {line_no}\")\n            seen_ids.add(case_id)\n\n            category: str = record[\"category\"]\n            prompt: str = record[\"prompt\"]\n\n            # Optional fields with defaults\n            max_tokens: int = record.get(\"max_tokens\", ",
