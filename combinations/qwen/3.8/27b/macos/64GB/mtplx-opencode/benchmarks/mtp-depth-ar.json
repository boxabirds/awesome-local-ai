      "text": "```python\n    lines = path.read_text(encoding=\"utf-8\").splitlines()\n    cases: list[PromptCase] = []\n    seen_ids: set[str] = set()\n    for lineno, raw in enumerate(lines, start=1):\n        stripped = raw.strip()\n        if not stripped:\n            continue\n        try:\n            obj = json.loads(stripped)\n        except json.JSONDecodeError as e:\n            raise ValueError(f\"Line {lineno}: invalid JSON: {e}\") from e\n        if not isinstance(obj, dict):\n            raise ValueError(f\"Line {lineno}: expected JSON object, got {type(obj).__name__}\")\n        missing = [k for k in (\"id\", \"category\", \"prompt\") if k not in obj]\n        if missing:\n            raise ValueError(f\"Line {lineno}: missing required fields: {missing}\")\n        pid: str = obj[\"id\"]\n        category: str = obj[\"category\"]\n        prompt: str = obj[\"prompt\"]\n        if not isinstance(pid, str) or not pid:\n            raise ValueError(f\"Line {lineno}: 'id' must be a non-empty string\")\n        if not isinstance(category, str) or not category:\n            raise ValueError(f\"Line {lineno}: 'category' must be a non-empty string\")\n        if not isinstance(prompt, str) or not prompt:\n            raise ValueError(f\"Line {lineno}: 'prompt' must be a non-empty string\")\n        if pid in seen_ids:\n            raise ValueError(f\"Line {lineno}: duplicate id '{pid}'\")\n        seen_ids.add(pid)\n        max_tokens = obj.get(\"max_tokens\", 128)\n        if not isinstance(max_tokens, int) or max_tokens <= 0:\n            raise ValueError(f\"Line {lineno}: 'max_tokens' must be a positive integer\")\n        notes = obj.get(\"notes\", \"\")\n        if not isinstance(notes, str):\n            raise ValueError(f\"Line {lineno}: 'notes' must be a string\")\n        cases.append(PromptCase(id=pid, category=category, prompt=prompt, max_tokens=max_tokens, notes=notes))\n    if not cases:\n        raise ValueError(f\"Prompt suite at {path} contains no cases\")\n    return cases\n\n\ndef export_prompt_suite(cases: Iterable[PromptCase], dest: Path) ->",
