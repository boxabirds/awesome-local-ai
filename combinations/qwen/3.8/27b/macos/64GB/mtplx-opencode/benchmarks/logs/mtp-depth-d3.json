          "text": "```python\ndef load_prompt_suite(path: Path) -> list[PromptCase]:\n    \"\"\"Load a JSONL prompt suite and validate required fields.\"\"\"\n    cases: list[PromptCase] = []\n    with path.open(\"r\", encoding=\"utf-8\") as fh:\n        for lineno, raw in enumerate(fh, start=1):\n            line = raw.strip()\n            if not line:\n                continue\n            try:\n                obj: dict[str, Any] = json.loads(line)\n            except json.JSONDecodeError as exc:\n                raise ValueError(f\"line {lineno}: invalid JSON: {exc}\") from exc\n\n            missing: list[str] = [\n                key for key in (\"id\", \"category\", \"prompt\") if key not in obj\n            ]\n            if missing:\n                raise ValueError(f\"line {lineno}: missing required fields: {missing}\")\n\n            cases.append(\n                PromptCase(\n                    id=str(obj[\"id\"]),\n                    category=str(obj[\"category\"]),\n                    prompt=str(obj[\"prompt\"]),\n                    max_tokens=int(obj.get(\"max_tokens\", 128)),\n                    notes=str(obj.get(\"notes\", \"\")),\n                )\n            )\n    return cases\n\n\ndef iter_prompts(cases: Iterable[PromptCase]) -> Iterator[PromptCase]:\n    \"\"\"Yield prompts in deterministic order (sorted by id).\"\"\"\n    return iter(sorted(cases, key=lambda c: c.id))\n\n\ndef build_request(\n    case: PromptCase,\n    model: str = \"gpt-4o\",\n    temperature: float = 0.0,\n    timeout: float = 30.0,\n) -> dict[str, Any]:\n    \"\"\"Build a canonical API request payload for a prompt case.\"\"\"\n    return {\n        \"model\": model,\n        \"messages\": [\n            {\"role\": \"user\", \"content\": case.prompt},\n        ],\n        \"max_tokens\": case.max_tokens,\n        \"temperature\": temperature,\n        \"timeout\": timeout,\n    }\n\n\ndef parse_response(raw: dict[str, Any]) -> str:\n    \"\"\"Extract completion text from an OpenAI-compatible response.\"\"\"\n    choices = raw.get(\"choices\")\n    if not isinstance(choices, list) or not choices:\n        raise ValueError(\"response missing 'choices' list\")\n    first = choices[0]\n    message",
