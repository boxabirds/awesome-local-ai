{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2025-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_ROOM", "class_name": "BoardRoom" }
    ]
  },
  // Story 12: images are stored in R2 (unguessable keys, immutable serving).
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }
  ],
  // Test-only: enables the /__test routes (story 5). This project is not
  // deployed to production; see NOTES.md.
  "vars": { "TEST_HOOKS": "1" }
}
