{
  // Test-only config: identical to wrangler.jsonc but with TEST_HOOKS enabled
  // so the /__test/ storage hooks (corrupt/repair a board's snapshot) are live.
  // Used by the broken-board E2E case via `wrangler dev --config wrangler.test-hooks.jsonc`.
  "name": "vidi6",
  "compatibility_date": "2025-06-30",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  "vars": {
    "TEST_HOOKS": "1"
  }
}
