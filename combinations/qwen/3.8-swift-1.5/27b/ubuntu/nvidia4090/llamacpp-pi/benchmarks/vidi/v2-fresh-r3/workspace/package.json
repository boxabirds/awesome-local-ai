{
  "name": "vidi6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "test:integration": "vitest run --config vitest.integration.config.ts && INTEGRATION_PORT=23030 vitest run --config vitest.integration-server.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:nightly": "playwright test --project chromium --grep @nightly"
  },
  "dependencies": {
    "lib0": "^0.2.119",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@playwright/test": "^1.52.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.28.0"
  }
