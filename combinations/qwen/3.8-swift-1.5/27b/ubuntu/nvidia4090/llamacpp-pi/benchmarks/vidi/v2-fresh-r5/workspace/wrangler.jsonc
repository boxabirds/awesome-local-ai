{
  "name": "vidi6",
  // 2025-06-30 enables the Durable Object hibernation API (acceptWebSocket,
  // getWebSockets, runInDurableObject) used by story 4's persistent room and
  // the Durable Object RPC (initialize/exists) used by story 5's board API.
  "compatibility_date": "2025-06-30",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ]
}
