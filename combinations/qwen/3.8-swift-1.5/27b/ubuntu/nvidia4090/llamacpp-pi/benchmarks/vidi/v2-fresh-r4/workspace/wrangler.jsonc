{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2025-09-01",
  // The Worker entry point (main) arrives in story 3. Until then this
  // configuration serves the static client build from dist/client, so
  // `wrangler dev` is the app server from day one.
  "assets": {
    "directory": "dist/client"
  }
}
