{
  "name": "vidi6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "build:test": "vite build --mode test",
    "test:unit": "vitest run --project=unit",
    "test:component": "vitest run --project=component",
    "test:integration": "npm run build && vitest run --project=integration",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:persistence": "playwright test -c playwright.persistence.config.ts --project=chromium-persistence",
    "test:e2e:nightly": "playwright test --project=nightly",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.12.0",
    "@cloudflare/workers-types": "^5.20260928.1",
    "@playwright/test": "^1.48.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "jsdom": "^25.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
