# Worker binding env file for the e2e dev server (playwright.config.ts
# webServer): enables the /_test/ seam (board initialize, state, snapshot
# corruption). Production config never sets TEST_HOOKS (TC-24 asserts the
# hooks are absent). wrangler dev does not inherit shell env as bindings,
# hence this file (wrangler 4's --var mangles KEY=VALUE).
TEST_HOOKS=1
