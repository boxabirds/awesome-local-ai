{
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // Story 5: the e2e SUITE creates far more than 10 boards per minute (every
  // spec creates boards), so the shared e2e server uses a high limit. The
  // exact BOARD_CREATE_LIMIT boundary is asserted against wrangler.test.jsonc
  // (limit = BOARD_CREATE_LIMIT) in integration TC-13 and e2e TC-30.
  // (Local runtime falls back to an in-memory limiter; see create-board.ts.)
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "00000000-0000-0000-0000-000000000000",
      "simple": { "limit": 1000000, "period": 60 }
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ],
  "vars": {
    "TEST_HOOKS": "1"
  }
}
