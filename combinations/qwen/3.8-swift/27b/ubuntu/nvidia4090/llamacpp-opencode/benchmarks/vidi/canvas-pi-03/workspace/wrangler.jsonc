{
  "name": "vidi6",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BOARD_ROOM",
        "class_name": "BoardRoom"
      }
    ]
  },
  // Story 5: board-creation rate limit. simple.limit/period mirror
  // BOARD_CREATE_LIMIT and BOARD_CREATE_PERIOD_SECONDS in src/shared/config.ts
  // (unit TC-03 asserts the two do not drift). namespace_id is the UUID of the
  // Cloudflare rate-limit namespace; the zero UUID is a local placeholder —
  // deploy with the real namespace id created in the Cloudflare dashboard.
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "00000000-0000-0000-0000-000000000000",
      "simple": { "limit": 10, "period": 60 }
    },
    // Story 12: image upload rate limit. simple.limit/period mirror
    // IMAGE_UPLOAD_LIMIT / IMAGE_UPLOAD_PERIOD_SECONDS in src/shared/config.ts.
    {
      "name": "ASSET_UPLOAD_LIMITER",
      "namespace_id": "00000000-0000-0000-0000-000000000000",
      "simple": { "limit": 60, "period": 60 }
    }
  ],
  // Story 12: R2 bucket for image assets (immutable keys <boardId>/<assetId>).
  "r2_buckets": [
    { "binding": "ASSETS_BUCKET", "bucket_name": "vidi6-assets" }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"]
    }
  ]
}
