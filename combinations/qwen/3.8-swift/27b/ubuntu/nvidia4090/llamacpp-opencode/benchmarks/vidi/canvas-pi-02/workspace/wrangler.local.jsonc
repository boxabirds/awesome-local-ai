// Local runtime config for the vitest integration pool: identical to
// wrangler.jsonc EXCEPT for the ratelimits binding, which this workerd build
// does not implement (it throws "RPC receiver does not implement entries").
// Production and e2e (wrangler dev) use wrangler.jsonc with the real binding;
// integration tests exercise the worker's local-limiter stand-in instead.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vidi6",
  "compatibility_date": "2025-09-01",
  "main": "src/worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "BOARD_ROOM", "class_name": "BoardRoom" }]
  },
  // SQLite-backed so story 4's persistence needs no class migration.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }]
}
