{
  "name": "vidi6",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:e2e": "vite build --mode test",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --project unit",
    "test:component": "vitest run --project component",
    "pretest:integration": "npm run build",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit && npm run test:e2e:persistence",
    "pretest:e2e:persistence": "npm run build:e2e",
    "test:e2e:persistence": "playwright test -c playwright.persistence.config.ts",
    "test:e2e:nightly": "playwright test --project=nightly"
  },
  "dependencies": {
    "lib0": "^0.2.118",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@playwright/test": "^1.52.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.20.0"
  }
}
