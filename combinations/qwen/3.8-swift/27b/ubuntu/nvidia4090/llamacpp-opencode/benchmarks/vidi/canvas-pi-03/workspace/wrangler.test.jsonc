{
  // Test variant of wrangler.jsonc used by the integration (workerd) pool.
  //
  // Story 4: the Durable Object binding + sqlite migrations ARE declared so the
  // integration pool runs a real BoardRoom Durable Object with real SQLite
  // storage (exercised via `runInDurableObject`). Each test uses a unique
  // board id, so per-object storage files never collide and shared storage
  // across tests is safe.
  "name": "vidi6-test",
  "main": "src/worker/index.ts",
  "compatibility_date": "2024-12-01",
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [
      { "name": "BOARD_ROOM", "class_name": "BoardRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["BoardRoom"] }
  ],
  // Story 5: mirrors wrangler.jsonc. The local runtime does not implement the
  // ratelimits binding, so the worker falls back to an in-memory limiter with
  // the same limit/period (see src/worker/create-board.ts).
  "ratelimits": [
    {
      "name": "BOARD_CREATE_LIMITER",
      "namespace_id": "00000000-0000-0000-0000-000000000000",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  // Enables the /__test/ ops routes for the integration + e2e suites. This is
  // ONLY in the test config — the production wrangler.jsonc never sets it, so
  // the hook routes are absent in production builds.
  "vars": {
    "TEST_HOOKS": "1"
  }
}
