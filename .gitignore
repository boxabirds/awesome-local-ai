# Run artefacts produced by the installers
install.log
*.log

# ...except archived benchmark evidence, which is the point of keeping it
!combinations/**/benchmarks/logs/*.log

# Models and build trees live outside the repo, but guard against stray copies
*.gguf
build/
benchmarks/perf/results/

# macOS / editor cruft
.DS_Store
__pycache__/
.ceetrix/

# The v1 held-out suite once published here (removed from history 30 Sep 2026); a local copy must never be re-added.
benchmarks/vidi/acceptance/

# coverage.py data from a local coverage run
.coverage

# Archived runs (plans/20261003-archive-superseded-records.md): kept on this machine only, never committed
/archive/

# Local secrets (an API key): never committed
/.env
